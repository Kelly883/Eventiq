{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "bacon/bacon-qr-code": "^2.0",
        "flutterwavedev/flutterwave-v3": "^1.0",
        "kreait/firebase-php": "^7.0",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "mews/purifier": "^3.4",
        "pusher/pusher-php-server": "^7.2",
        "rebing/graphql-laravel": "*",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "unicodeveloper/laravel-paystack": "^1.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Features\\Analytics\\": "app/Features/analytics/",
            "App\\Features\\ApiKeys\\": "app/Features/api-keys/",
            "App\\Features\\CheckIn\\": "app/Features/check-in/",
            "App\\Features\\Checkout\\": "app/Features/checkout/",
            "App\\Features\\Compliance\\": "app/Features/compliance/",
            "App\\Features\\Dashboard\\": "app/Features/dashboard/",
            "App\\Features\\Delivery\\": "app/Features/delivery/",
            "App\\Features\\EmailNotifications\\": "app/Features/email-notifications/",
            "App\\Features\\EventsCalendar\\": "app/Features/events-calendar/",
            "App\\Features\\Fraud\\": "app/Features/fraud/",
            "App\\Features\\Inventory\\": "app/Features/inventory/",
            "App\\Features\\Notifications\\": "app/Features/notifications/",
            "App\\Features\\OfflineSync\\": "app/Features/offline-sync/",
            "App\\Features\\OrganizerProfile\\": "app/Features/organizer-profile/",
            "App\\Features\\Payment\\": "app/Features/payment/",
            "App\\Features\\Payouts\\": "app/Features/payouts/",
            "App\\Features\\Preferences\\": "app/Features/preferences/",
            "App\\Features\\Pricing\\": "app/Features/pricing/",
            "App\\Features\\PushNotifications\\": "app/Features/push-notifications/",
            "App\\Features\\QRCodeTicketing\\": "app/Features/qr-code-ticketing/",
            "App\\Features\\Refunds\\": "app/Features/refunds/",
            "App\\Features\\Ticketing\\": "app/Features/ticketing/",
            "App\\Features\\Tickets\\": "app/Features/tickets/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "composer/package-versions-deprecated": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
