APP_NAME=EventIQ
APP_ENV=local
APP_KEY=
# !!! PRODUCTION MUST BE false — true leaks stack traces for 429/500 on api/*
# Render's render.yaml already forces APP_DEBUG=false in production.
# Local dev can stay true; never commit a .env with true to prod.
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en

# Database
# Production: PostgreSQL via Render's eventiq-db (see render.yaml).
# Local development: SQLite (uncomment DB_CONNECTION=sqlite to override).
DB_CONNECTION=pgsql
#DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eventiq
DB_USERNAME=eventiq
DB_PASSWORD=
DB_CHARSET=utf8
DB_SSL_MODE=prefer

# Stateless sessions: signed cookies (no DB access on every request). This
# keeps GET /health (Render healthCheckPath) 200 and the web middleware
# group healthy even if Postgres is briefly unreachable; Sanctum web/session
# auth is unaffected. Postgres still stores all application data.
SESSION_DRIVER=cookie
# Cache: database is fine on Postgres; switch to "redis" if you provision
# a Redis instance for production.
CACHE_STORE=database
# Queue: sync for local dev (jobs run inline). Use "database" in production
# (requires a worker: `php artisan queue:work`) or "redis" if you provision
# a Redis instance.
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_STACK=daily,audit
LOG_LEVEL=debug

# Restored - dropped in an earlier restructuring push. Needed for
# TicketDeliveryService::sendViaEmail() and EmailTemplateService::sendTest()
# (both use Mail::), and for password-reset emails via config/auth.php.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@eventiq.example
MAIL_FROM_NAME="${APP_NAME}"

# Frontend origin(s) allowed to call this API (comma-separated).
# Include the Vite dev server port (3000) and its automatic fallback (3001)
# so registration/login keep working if port 3000 is already in use.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001

VITE_MIXPANEL_TOKEN=
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPPORTED_LANGUAGES=en,es,fr,de,pt,zh,ja,ar
VITE_DEFAULT_LANGUAGE=en

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_PAYMENT_URL=https://api.flutterwave.com/v3
# Separate "Secret Hash" from the Flutterwave dashboard, used only for
# webhook signature verification - not the same as the API secret key.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

APP_CURRENCY=NGN

VITE_PAYSTACK_PUBLIC_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=

# Sift Science fraud detection
SIFT_API_KEY=
SIFT_ACCOUNT_ID=
SIFT_API_BASE_URL=https://api.sift.com/v205

# Fraud risk thresholds (overridable per environment)
HIGH_RISK_THRESHOLD=75
MEDIUM_RISK_THRESHOLD=31
VELOCITY_LIMIT_24H=10
VELOCITY_LIMIT_1H=3
CARD_TESTING_THRESHOLD=5
MAX_TICKETS_PER_TRANSACTION=10
MAX_TRANSACTIONS_PER_DEVICE=5
MAX_TRANSACTIONS_PER_IP=10

# Ticket delivery (email + SMS). NOT "bam-ticketing" - that package
# doesn't exist for PHP/Composer. See config/ticket-delivery.php.
TICKET_DELIVERY_EMAIL_FROM=
TICKET_DELIVERY_EMAIL_FROM_NAME=EventIQ
TICKET_DELIVERY_SMS_FROM=
TICKET_DELIVERY_WEBHOOK_SECRET=
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=dnd

# MJML email rendering. MJML is a Node.js package with no PHP port - this
# server needs Node.js installed for it to work. See config/mjml.php and
# backend/node-tools/mjml/ (run `npm install` there once, separately from
# the PHP composer install).
MJML_ENABLED=true
MJML_NODE_BINARY=node

# Firebase Admin SDK (push notifications). Download the service account
# JSON from Firebase Console > Project Settings > Service Accounts, save
# it at the path below (gitignored), never commit it.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json

# Payouts (refunds/settlements) - use the same Paystack/Flutterwave
# gateways above via PaymentGatewayService, not a separate Stripe/PayPal
# integration. See PAYSTACK_*/FLUTTERWAVE_* vars earlier in this file.
PAYOUT_HOLD_DAYS=3
PAYOUT_MAX_RETRIES=3
AUDIT_LOG_ENABLED=true

# Audit trail (config/logging.php's 'audit' channel + audit_logs table).
# LOG_DAILY_DAYS controls file rotation (disk space);
# AUDIT_LOG_RETENTION_DAYS is a separate concern - how long DB rows are
# kept for compliance purposes (365 = 1yr, 2555 = 7yr are common
# regulatory minimums, adjust to your actual requirements).
LOG_DAILY_DAYS=14
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_EXTERNAL_LOG_SERVICE=none
COMPLIANCE_REPORT_QUEUE=compliance

# Trusted proxies — critical for correct $request->ip() and rate limits.
# Local: leave empty (no trust, safest). Production on Render/Vapor: "*".
# Cloudflare: "173.245.48.0/20,103.21.244.0/22,108.162.192.0/18" etc.
TRUSTED_PROXIES=
# TRUSTED_PROXY_HEADERS rarely needs changing; see config/trustedproxy.php

# Hashing — bcrypt is default (cost 12). For lower CPU, set argon2id in prod
# if PHP has it (php -m | grep argon). See config/hashing.php.
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12

# CAPTCHA (Cloudflare Turnstile) — required after 2 failed logins.
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_ENABLED=false in local .env to disable; true in prod.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
