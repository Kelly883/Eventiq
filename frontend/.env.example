# Backend API URL
# - Local dev:        http://localhost:8000  (php artisan serve)
# - Production:       the live Render backend URL, e.g.
#                     https://eventiq-qvh2.onrender.com
# - In Render:        wired automatically via render.yaml fromService, so
#                     this only needs to be set when running `npm run build`
#                     locally outside Render.
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: run the app against the in-browser mock API layer (MSW) instead of
# a live backend. Equivalent to `npm run dev:mock`, or visiting /?msw=1.
# VITE_USE_MSW=true

# Payment Gateway Public Keys (required for checkout)
# Obtain from your Paystack/Flutterwave dashboard
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxx
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx

# Turnstile CAPTCHA (Cloudflare) — shown after 2 failed logins when backend
# TURNSTILE_ENABLED=true. Get site key from https://dash.cloudflare.com/?to=/:account/turnstile
# Local dev: leave empty to disable widget (or set TURNSTILE_ENABLED=false in backend)
VITE_TURNSTILE_SITE_KEY=
